# Required in production: Upstash Redis REST credentials.
# The Vercel Marketplace integration may inject either the UPSTASH_* names or
# the legacy-compatible KV_* names. The application supports both pairs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
ALLOWED_ORIGINS=https://whisper.andri.is
